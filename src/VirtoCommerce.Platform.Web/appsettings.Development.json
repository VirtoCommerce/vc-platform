{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Debug"
    ],
    "MinimumLevel": {
      "Default": "Verbose",
      "Override": {
        "System": "Information",
        "Microsoft": "Information",
        "Microsoft.AspNetCore.SignalR": "Verbose",
        "Microsoft.AspNetCore.Http.Connections": "Verbose",
        "VirtoCommerce.Platform.Modules": "Information",
        "VirtoCommerce.Platform.Web.Startup": "Information"
      }
    },
    "WriteTo": [
      "Console",
      "Debug"
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  // The Admin Shell app (/apps/admin-shell) shows the AngularJS admin and other apps in a same-origin iframe
  "SecurityHeaders": {
    "FrameOptions": "SameOrigin"
  },
  // Match the URL of the VirtoCommerce.Platform.Web launch profile
  "Assets": {
    "FileSystem": {
      "PublicUrl": "http://localhost:10645/assets/"
    }
  },
  "Content": {
    "FileSystem": {
      "PublicUrl": "http://localhost:10645/cms-content/"
    }
  }
}
